# Copy to ./.env or ~/.autocutter/.env
ANTHROPIC_API_KEY=your_key_here

# Whisper (optional — defaults match current behavior)
# WHISPER_MODEL=medium
# WHISPER_WORD_TIMESTAMPS=true
#
# Fast demo overnight:
# WHISPER_MODEL=small
# WHISPER_WORD_TIMESTAMPS=false

# Word-level filler trim inside KEPT segments at export (default: off)
# Requires words.json from a word_timestamps=true transcription.
# TRIM_FILLER_WORDS=false
# TRIM_FILLER_WORDS=true
